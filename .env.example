# Required for category pages to automatically pull images from your
# Cloudinary folders (see README section 5). Get these from your
# Cloudinary Dashboard (cloudinary.com/console) — Cloud name, API Key
# and API Secret are all shown right on the main page after you log in.
#
# CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET are private — never put
# NEXT_PUBLIC_ in front of them, and never commit real values (this file
# is just the template; your real values go in .env.local, which is
# already gitignored).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — only needed once you wire the contact form up to Resend
# (see app/api/contact/route.ts). Not required to run the site locally.
RESEND_API_KEY=
